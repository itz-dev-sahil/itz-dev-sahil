<group name="cowrie,honeypot,">
  <!-- Local IDs are intentionally in the custom-rule range. Validate each field name against your Cowrie event output. -->
  <rule id="100100" level="3">
    <decoded_as>cowrie-json</decoded_as>
    <field name="eventid">^cowrie\.</field>
    <description>Cowrie: honeypot event observed</description>
    <group>cowrie,</group>
  </rule>
  <rule id="100101" level="6">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.login\.failed$</field>
    <description>Cowrie: failed SSH authentication attempt</description>
    <group>authentication_failed,cowrie,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100102" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie: repeated failed SSH authentication attempts</description>
    <group>brute_force,cowrie,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100103" level="8">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.command\.input$</field>
    <description>Cowrie: command entered in honeypot session</description>
    <group>command,cowrie,</group>
    <mitre><id>T1059</id></mitre>
  </rule>
</group>
